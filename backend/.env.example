# LexMap backend environment variables
# Copy this file to .env and fill in your values.

# Required: Groq API key for the Lex AI assistant (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: secret used to sign JWTs. Set a strong value in production.
JWT_SECRET=your_secret_key_here

# Optional: backend port (defaults to 5000)
PORT=5000
